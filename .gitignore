# Ambiente local e ficheiros das ferramentas
.idea/
.venv/
__pycache__/
*.py[cod]

# Resultados: versionar apenas manifestos, tabelas e o detalhe por resposta.
# As restantes saídas (caches JSONL, figuras) ficam fora do repositório.
results/**
!results/**/
!results/meta2/**/manifest.json
!results/meta2/**/all_results.csv
!results/meta2/**/tabela_*.csv

# Caches de previsões/vereditos e eventuais modelos
results/**/*.jsonl
models/
*.gguf
*.safetensors

# RAG (Meta 3): o índice vetorial é regenerável; versionar corpus e fontes.
data/rag/**/chroma/
!results/meta3/**/
!results/meta3/**/manifest.json
!results/meta3/**/all_results.csv
!results/meta3/**/tabela_*.csv
!results/meta3/**/recuperacao_*.csv
!results/meta3/**/comparacao_*.csv
!results/meta3/**/efeito_*.csv
